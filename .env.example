# ===========================================================================
# LPGP Ops Panel (TrackerLPGP) -- environment variables
# ===========================================================================
# Copy to .env for local dev. In production set the same names under
# Vercel -> TrackerLPGP -> Settings -> Environment Variables.
#
# This app is the source of truth for money: signed deals, invoices, and how
# each sponsor's payment is split across events. Treat every secret here as
# a financial credential.
# ===========================================================================

# --- Database (required) ---------------------------------------------------
# Neon Postgres connection string. POSTGRES_URL is read as a fallback, so
# either name works; Vercel's Neon integration sets POSTGRES_URL for you.
# Without it the app starts but every page reports "database not configured".
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Session signing (required in production) ------------------------------
# Signs the login cookie. There IS a built-in fallback value in the code so a
# fresh clone runs, and that fallback is public -- anyone reading the source
# can mint a valid admin session with it. Set your own before this is
# reachable from the internet.
#   openssl rand -hex 32
JWT_SECRET=generate-your-own-do-not-ship-the-default

# --- Admin notifications (optional) ----------------------------------------
# Where "a deal was added" style mail goes. Leave SMTP_HOST unset and the app
# simply sends nothing -- no errors, no queue.
ADMIN_EMAIL=you@company.com
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey-or-username
SMTP_PASS=the-smtp-password
SMTP_FROM=LPGP Tracker <no-reply@yourcompany.com>

# --- The sales-CRM bridge --------------------------------------------------
# These two are the link to the sales CRM. Whatever you put here must be typed
# identically into the CRM's own environment, or the handshake fails.
#
# OPS_BRIDGE_KEY grants READS: company matching, events, sponsors, deals.
# Without it every /api/bridge/* request is refused and the CRM quietly hides
# all its ops-panel features.
#   openssl rand -hex 32
OPS_BRIDGE_KEY=shared-read-secret-same-value-on-both-apps

# OPS_BRIDGE_WRITE_KEY grants WRITES: creating a deal, attaching an invoice,
# ticking signed. Optional and OFF by default -- leave it unset and every
# write returns 503 while reads keep working.
#
# It must be a DIFFERENT value from OPS_BRIDGE_KEY. Two secrets is the whole
# point: a leaked read key must never be able to create a financial record.
# OPS_BRIDGE_WRITE_KEY=a-second-different-secret-same-value-on-both-apps

# --- Optional extras -------------------------------------------------------
# Port for local dev (defaults to 3000).
# PORT=3000

# Powers the in-app assistant only. Every other feature works without it.
# ANTHROPIC_API_KEY=sk-ant-...
